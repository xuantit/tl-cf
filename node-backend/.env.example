# ── Server ────────────────────────────────────────────────────────────────
PORT=9000
CORS_ORIGINS=http://localhost:5199
# Số proxy tin cậy đứng trước (Cloudflare Tunnel / nginx). 0 = không có proxy.
# Sai giá trị này → rate limit và audit log ghi nhầm IP.
TRUST_PROXY_HOPS=1
# Đặt true chỉ khi debug: tắt toàn bộ rate limit.
# RATE_LIMIT_DISABLED=false
# Đặt true chỉ khi debug: trả message/stack lỗi thật về client.
# DEBUG_ERRORS=false

# ── Turnstile anti-bot ────────────────────────────────────────────────────
# Use .env.turnstile.development / .env.turnstile.production (both gitignored).
# Process env overrides those files. Tests do not load them.
# Configure these variables in the environment-specific file, not shared .env:
# TURNSTILE_ENABLED=true
# TURNSTILE_SITE_KEY=<public widget sitekey>
# TURNSTILE_SECRET_KEY=<private widget secret>
# TURNSTILE_ALLOWED_HOSTNAMES=cf.mmthui.xyz
# Production refuses disabled/missing settings, official dummy keys, localhost.
# GET /api/auth/turnstile supplies public config; no frontend build-time key needed.
# HOST defaults to 127.0.0.1 in production (Cloudflare Tunnel on same machine).

# ── Email registration (Resend) ──────────────────────────────────────────
# Create a sending API key at https://resend.com/api-keys and verify a domain.
# Missing any of these settings disables signup; existing accounts still work.
RESEND_API_KEY=
# Plain email address on your verified domain (not a display name).
RESEND_FROM_EMAIL=
# Frontend origin. Production: https://cf.mmthui.xyz (HTTPS required).
APP_URL=http://localhost:5199
# Persistent rolling 24h mail-attempt budgets (including provider failures).
REGISTRATION_EMAIL_DAILY_LIMIT=5
REGISTRATION_GLOBAL_DAILY_LIMIT=100
# /auth/setup is disabled by default; prefer db:seed for the initial admin.
# If needed: random secret >=32 chars, passed in X-Setup-Token (never a URL).
# INITIAL_SETUP_TOKEN=

# ── Secrets ──────────────────────────────────────────────────────────────
# JWT_SECRET: tối thiểu 32 ký tự ngẫu nhiên. BẮT BUỘC khi NODE_ENV=production.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
# ENCRYPTION_KEY: exactly 64 hex chars (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Database ──────────────────────────────────────────────────────────────
# Plain Postgres URL. Do NOT put https:// in the host.
# Local docker (docker compose -f docker-compose.node.yml up -d postgres):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cftool
# Supabase pooler example (note: no https:// in the host):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Default admin seeding (auto-runs on first boot if DB has no users) ──────
# MẶC ĐỌNH TẮT khi NODE_ENV=production. Nếu bật ở production thì BẮT BUỘC phải
# đổi DEFAULT_ADMIN_PASSWORD, nếu không server sẽ từ chối khởi động.
AUTO_SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123

# ── Optional demo user for `npm run db:seed` ────────────────────────────────
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=Demo@1234

# ── Optional Cloudflare account seeded by `npm run db:seed` ─────────────────
# Set an API token to auto-attach a CF account to the admin user:
# SEED_CF_AUTH_TYPE=apiToken
# SEED_CF_LABEL=Seeded account
# SEED_CF_API_TOKEN=your-cloudflare-api-token
# Or use a Global API Key instead:
# SEED_CF_AUTH_TYPE=globalApiKey
# SEED_CF_EMAIL=you@example.com
# SEED_CF_GLOBAL_API_KEY=your-global-api-key
