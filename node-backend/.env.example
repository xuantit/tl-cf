# --- Database --------------------------------------------------------------
# PostgreSQL connection string: postgresql://<user>:<password>@<host>:<port>/<db>
# Local dev (Postgres exposed on host port 5433 via docker-compose.node.yml):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cftool

# --- Security (REQUIRED) ---------------------------------------------------
# 64 hex chars (32 bytes). Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# Min 16 chars. Generate: openssl rand -hex 24
JWT_SECRET=

# --- Server ----------------------------------------------------------------
PORT=9000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- Default admin (seeded on first run) -----------------------------------
AUTO_SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123
